# Dall'esempio 02_lvgl_demo_v9 di Waveshare, senza le demo di LVGL.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_FREERTOS_HZ=1000

CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_26=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_USE_FONT_COMPRESSED=y

# Giro 2: la console passa dal cavo USB (USB Serial/JTAG), cosi' la pagina dell'abbinamento
# legge le risposte e scrive i comandi; certificati delle autorita' per parlare col ponte in HTTPS.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Giro 3: aggiornamento via wifi. Un programma nuovo parte "in prova": se non si dichiara buono
# (aggiorna_conferma, dopo la prima risposta del PC) il riavvio successivo torna a quello vecchio.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Connessioni HTTPS (25/11/2026): nel registro dell'orologio "mbedtls_ssl_setup returned -0x7F00" (memoria esaurita)
# al primo invio al ponte. I buffer delle connessioni sicure vanno nella PSRAM esterna; la memoria interna resta allo
# schermo e al wifi. Opzione documentata di ESP-IDF (Component config > mbedTLS > Memory allocation strategy).
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Aggiornamento via wifi (25/11/2026): nel registro "esp-aes: Failed to allocate memory" e "esp-tls-mbedtls: read error"
# durante lo scaricamento: la cifratura AES in hardware chiede memoria interna per il DMA e non la trova. La fa il processore:
# un po' piu' lento, nessuna memoria interna in piu'. Opzione documentata di ESP-IDF (mbedTLS > Enable hardware AES acceleration).
CONFIG_MBEDTLS_HARDWARE_AES=n

# Microfoni (26/11/2026): alla prima pressione di BOOT "avvio I2S: ESP_ERR_NO_MEM (DMA libera 4891)". L'I2S chiede circa 17 KB
# di memoria interna per il DMA (6 buffer da 240 frame per l'uscita stereo e per l'ingresso a 4 posti, valori di
# I2S_CHANNEL_DEFAULT_CONFIG in ESP-IDF v5.5.5) e ne restano 5. Sull'ESP32-S3 la memoria interna e' una sola per codice
# (IRAM) e dati: le funzioni del wifi tenute li' per velocita' si lasciano nella flash. Testo del Kconfig di esp_wifi v5.5.5:
# piu' di 10 KB (IRAM_OPT) e piu' di 17 KB (RX_IRAM_OPT) di IRAM risparmiati, wifi un po' piu' lento. Lo schermo non cambia.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n

# Microfoni, secondo giro (26/11/2026): con le due righe sopra l'errore e' rimasto. Causa: con la PSRAM, malloc() mette
# prima nella memoria interna ogni richiesta fino a CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL byte (default 16384, Kconfig di
# esp_psram v5.5.5) e passa alla PSRAM solo quando la interna e' finita: oggetti di LVGL (CONFIG_LV_USE_CLIB_MALLOC),
# cJSON e client HTTP la riempiono tutta, qualunque cosa si liberi. Nemmeno la riserva per il DMA li ferma: ha anche
# MALLOC_CAP_DEFAULT, quindi malloc() la usa quando il resto e' pieno (esp_psram_extram_reserve_dma_pool, esp_psram.c).
# Con 0 malloc() va prima nella PSRAM e la memoria interna resta a chi la chiede esplicitamente (DMA dell'I2S, pile dei
# compiti, wifi). E' il valore del firmware di fabbrica (examples/factory/sdkconfig.defaults di Waveshare). Lo schermo
# non cambia: il pacchetto della scheda chiede il buffer di disegno esplicitamente DMA interno (buff_dma, non buff_spiram);
# lo schermo verde visto con 0 il 25/11 era col pacchetto difettoso, che il disegno lo metteva nella PSRAM. La riserva per il DMA
# resta al default (32768), piu' prudente dei 4096 del firmware di fabbrica.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
